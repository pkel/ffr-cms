  "dns-client-mirage" {= "8.0.0"}
  "domain-name" {= "0.5.0"}
  "dot-merlin-reader" {= "5.8-505" & with-dev-setup}
  "duff" {= "0.5"}
  "dune" {= "3.24.0"}
  "dune-configurator" {= "3.24.0"}
  "duration" {= "0.3.1"}
  "either" {= "1.0.0"}
  "emile" {= "1.1"}
  "encore" {= "0.8.1"}
