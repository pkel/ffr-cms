  "cohttp-lwt" {= "6.1.1"}
  "cohttp-lwt-unix" {= "6.1.1"}
  "compiler-cloning" {= "enabled"}
  "conduit" {= "8.0.0"}
  "conduit-lwt" {= "8.0.0"}
  "conduit-lwt-unix" {= "8.0.0"}
  "conf-gmp" {= "5"}
  "conf-gmp-powm-sec" {= "4"}
  "conf-libev" {= "4-13"}
  "conf-libffi" {= "2.0.0"}
  "conf-pkg-config" {= "5"}
  "cppo" {= "1.8.0"}
