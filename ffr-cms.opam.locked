opam-version: "2.0"
name: "ffr-cms"
version: "dev"
synopsis: "FFR CMS based on OCaml Opium"
description: "."
maintainer: "patrik@pkel.dev"
authors: "Patrik Keller"
depends: [
  "angstrom" {= "0.16.1"}
  "argon2" {= "1.0.2"}
  "arp" {= "3.1.1"}
  "asn1-combinators" {= "0.2.6"}
  "astring" {= "0.8.5"}
  "awa" {= "0.3.1"}
  "awa-mirage" {= "0.3.1"}
  "b0" {= "0.0.5" & with-dev-setup}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.2"}
  "bheap" {= "2.0.0"}
  "bigstringaf" {= "0.10.0"}
  "bos" {= "0.3.0"}
  "ca-certs" {= "0.2.3"}
