  "mirage-unix" {= "5.0.1"}
  "mtime" {= "2.1.0"}
  "multipart-form-data" {= "0.3.0"}
  "num" {= "1.6"}
  "ocaml" {= "5.5.0"}
  "ocaml-base-compiler" {= "5.5.0"}
  "ocaml-compiler" {= "5.5.0"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-index" {= "5.8-505" & with-dev-setup}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0"}
  "ocaml_intrinsics_kernel" {= "v0.17.2"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.8"}
  "ocamlgraph" {= "2.2.0"}
  "ocp-indent" {= "1.9.0" & with-dev-setup}
  "ocplib-endian" {= "1.2"}
  "odig" {= "0.0.9" & with-dev-setup}
  "odoc" {= "3.2.1" & with-doc}
  "odoc-parser" {= "3.2.1" & with-doc}
  "opium" {= "0.20.0"}
  "optint" {= "0.3.0"}
  "paf" {= "0.6.0"}
  "parsexp" {= "v0.17.0"}
  "pbkdf" {= "1.2.0"}
  "pecu" {= "0.7"}
  "ppx_assert" {= "v0.17.0"}
  "ppx_base" {= "v0.17.0"}
  "ppx_cold" {= "v0.17.0"}
  "ppx_compare" {= "v0.17.0"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.1.2"}
  "ppx_enumerate" {= "v0.17.0"}
  "ppx_expect" {= "v0.17.3"}
  "ppx_globalize" {= "v0.17.2"}
  "ppx_hash" {= "v0.17.0"}
  "ppx_here" {= "v0.17.0"}
  "ppx_inline_test" {= "v0.17.1"}
  "ppx_irmin" {= "3.11.0"}
  "ppx_optcomp" {= "v0.17.1"}
  "ppx_repr" {= "0.8.0"}
  "ppx_sexp_conv" {= "v0.17.1"}
  "ppxlib" {= "0.38.0"}
  "ppxlib_jane" {= "v0.17.4"}
  "psq" {= "0.2.1"}
  "ptime" {= "1.2.0"}
  "randomconv" {= "0.1.3"}
  "re" {= "1.14.0"}
  "repr" {= "0.8.0"}
  "result" {= "1.5"}
  "rock" {= "0.20.0"}
  "rresult" {= "0.7.0"}
  "seq" {= "base"}
  "sexplib" {= "v0.17.0"}
  "sexplib0" {= "v0.17.0"}
  "stdio" {= "v0.17.0"}
  "stdlib-shims" {= "0.3.0"}
  "stringext" {= "1.6.0"}
  "tcpip" {= "8.1.0"}
  "time_now" {= "v0.17.0"}
  "tls" {= "0.17.5"}
  "tls-mirage" {= "0.17.5"}
  "topkg" {= "1.1.1"}
  "tyxml" {= "4.6.0"}
  "uri" {= "4.4.0"}
  "uri-sexp" {= "4.4.0"}
  "uutf" {= "1.0.4"}
  "x509" {= "0.16.5"}
  "yaml" {= "3.2.0"}
  "yojson" {= "3.0.0"}
  "zarith" {= "1.14"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]