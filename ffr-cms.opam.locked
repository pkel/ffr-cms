  "irmin-watcher" {= "0.5.0"}
  "jane-street-headers" {= "v0.17.0"}
  "jsonm" {= "1.0.2"}
  "jst-config" {= "v0.17.0"}
  "ke" {= "0.6"}
  "logs" {= "0.10.0"}
  "lru" {= "0.3.1"}
  "lwt" {= "6.1.2"}
  "lwt-dllist" {= "1.1.0"}
  "lwt_ppx" {= "6.1.0"}
  "macaddr" {= "5.6.2"}
  "macaddr-cstruct" {= "5.6.2"}
  "magic-mime" {= "1.3.1"}
  "merlin" {= "5.8-505" & with-dev-setup}
  "merlin-lib" {= "5.8-505" & with-dev-setup}
  "metrics" {= "0.5.0"}
  "mimic" {= "0.0.9"}
  "mimic-happy-eyeballs" {= "0.0.9"}
  "mirage-clock" {= "4.2.0"}
  "mirage-clock-unix" {= "4.2.0"}
  "mirage-crypto" {= "0.11.3"}
  "mirage-crypto-ec" {= "0.11.3"}
  "mirage-crypto-pk" {= "0.11.3"}
  "mirage-crypto-rng" {= "0.11.3"}
  "mirage-flow" {= "5.0.0"}
  "mirage-kv" {= "6.1.1"}
  "mirage-mtime" {= "5.2.0"}
  "mirage-net" {= "4.0.0"}
  "mirage-random" {= "3.0.0"}
  "mirage-runtime" {= "4.11.1"}
  "mirage-sleep" {= "4.1.0"}
